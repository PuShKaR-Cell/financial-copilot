{
  "expo": {
    "name": "Assistant",
    "slug": "mobile-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.mobileassistant",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.example.mobileassistant",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "INTERNET"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#111827"
        }
      ]
    ],
    "extra": {
      "defaultSearxngUrl": "http://192.168.1.42:8888",
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_PROJECT_ID"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/REPLACE_WITH_YOUR_PROJECT_ID"
    }
  }
}
